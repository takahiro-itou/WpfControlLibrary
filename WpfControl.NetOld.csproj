<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>WpfControl</AssemblyName>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>10.0</LangVersion>
    <Nullable>enable</Nullable>
    <Platforms>x64;x86</Platforms>
    <RootNamespace>WpfControl</RootNamespace>
    <TargetFrameworks>
      net48;
    </TargetFrameworks>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <Import Project="Props\OutputLibs.props" />

  <Import Project="WpfHelper\WpfHelper.props" />
  <Import Project="Editor\BinaryEditor\Targets.props" />
  <Import Project="Editor\MatrixEditor\Targets.props" />
  <Import Project="Sample\SampleControl\Targets.props" />
  <Import Project="Utils\ProgressBar\Targets.props" />

  <ItemGroup>
    <Compile Include="AssemblyInfo.cs" />
  </ItemGroup>

</Project>
