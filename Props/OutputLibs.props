<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <PropertyGroup>
    <CONFIG_NAME>$(Platform)-$(Configuration)</CONFIG_NAME>
    <OUTDIR_CONFIG>$(CONFIG_NAME)\$(TargetFramework)</OUTDIR_CONFIG>
  </PropertyGroup>

  <!--  NET プロジェクト (C#, VB.NET) の設定  -->
  <PropertyGroup>
    <IntDir>$(OBJ_BASE_DIR)\$(CONFIG_NAME)</IntDir>
    <IntermediateOutputPath>$(IntDir)\</IntermediateOutputPath>
    <_IntermediateOutputPath>$(IntermediateOutputPath)</_IntermediateOutputPath>

    <OutDir>$(LIB_BASE_DIR)\$(OUTDIR_CONFIG)\$(MSBuildProjectName)\</OutDir>
  </PropertyGroup>

</Project>
