<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <PropertyGroup>
    <OBJ_BASE_DIR>$(SolutionDir)Objs\$(MSBuildProjectName)</OBJ_BASE_DIR>
    <LIB_BASE_DIR>$(SolutionDir)Libs</LIB_BASE_DIR>
    <BIN_BASE_DIR>$(SolutionDir)Bin</BIN_BASE_DIR>
  </PropertyGroup>

  <PropertyGroup Condition="'$(MSBuildProjectExtension)' != '.vcxproj'">
    <BaseIntermediateOutputPath>$(OBJ_BASE_DIR)\</BaseIntermediateOutputPath>
    <!--
    <MSBuildProjectExtensionsPath>$(OBJ_BASE_DIR)\</MSBuildProjectExtensionsPath>
    -->
  </PropertyGroup>

</Project>
